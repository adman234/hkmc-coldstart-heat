[nemesis]
version=1.1
id=coldstart.heat
name=Cold-start Heat
type=application,service
package-version=2.2.1
short-desc="Always heat wheel + seat action on every start"
os="*.260507"
models=any
postinstall=scripts/post.sh

[app.0]
kind=apk
path=app/coldstart.apk
package=com.nemesis.coldstart
component=com.nemesis.coldstart/.MainActivity

[service.0]
name=apply
kind=sh
path=svc/coldstart.sh
uid=root
mode=restart
